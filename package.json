{
  "name": "meclaw",
  "version": "1.0.0",
  "description": "Personal AI agent running locally with Telegram interface",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "deploy": "npm run build && npx firebase deploy --only functions",
    "set-webhook": "node scripts/set-webhook.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.13.6",
    "dotenv": "^16.4.5",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.9.0",
    "grammy": "^1.31.0",
    "groq-sdk": "^0.8.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "firebase-tools": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
